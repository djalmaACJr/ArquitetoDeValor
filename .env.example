# ============================================================
# Arquiteto de Valor — Variáveis de ambiente (testes Jest API)
#
# Copie este arquivo para `.env` (NÃO commitado) e preencha com
# os valores reais do seu projeto Supabase + conta de teste.
#
# Em CI/GitHub Actions, os mesmos nomes devem existir como
# Secrets (Settings → Secrets and variables → Actions).
# ============================================================

# ── Projeto Supabase ────────────────────────────────────────
# URL do projeto (em "API settings" do Dashboard)
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# Chave anon (publishable) — NÃO confundir com service_role
SUPABASE_ANON_KEY=

# ── Usuário principal de teste (User A) ─────────────────────
# Conta válida no projeto. Os testes de domínio (contas,
# categorias, transações, etc.) rodam com este usuário.
TEST_EMAIL=
TEST_PASSWORD=

# ── Usuário secundário (User B) — opcional ──────────────────
# Necessário para os testes de segurança/RLS (07_seguranca_rls,
# 08_seguranca_triggers cross-FK, 09_seguranca_rpc cross-user).
# Sem isso, ~9 testes pulam graciosamente.
TEST_EMAIL_B=
TEST_PASSWORD_B=
