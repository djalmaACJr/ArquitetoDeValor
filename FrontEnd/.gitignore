# Sessão salva pelo Playwright (e2e/tests/auth.setup.ts, storageState do
# projeto "data"/"firefox" em e2e/playwright.config.ts) — contém um JWT de
# acesso + refresh_token válidos do usuário de teste. NUNCA versionar: é
# regenerado sozinho a cada `npm run test:e2e` (auth.setup.ts roda como
# dependência antes dos demais projetos), não precisa existir no repo.
fixtures/auth.json

