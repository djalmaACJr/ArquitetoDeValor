# Parâmetros do robô investidor10. Copie para .env. NUNCA commitar.
#
# O login do investidor10 é via Google (OAuth) e é feito MANUALMENTE na
# primeira execução (janela aberta). Não há e-mail/senha aqui — a sessão
# fica guardada na pasta perfil/ (perfil persistente do navegador).

# URL da página de movimentações (default abaixo)
INV10_ENTRIES_URL=https://investidor10.com.br/wallet/my-wallet/pro/entries

# Modo CDP (opcional): reaproveita um Chrome/Edge JÁ ABERTO e logado, sem
# login automatizado. Para usar, abra o navegador com a porta de depuração
# (ver README) e descomente:
# INV10_CDP_URL=http://localhost:9222

# true = roda sem janela. SÓ funciona depois que a pasta perfil/ já tem uma
# sessão logada. O 1º login pelo Google exige janela (deixe false).
INV10_HEADLESS=false
